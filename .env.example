# Copy to .env and fill in. Never commit .env.

# none (default, no API key needed) | anthropic | openai | google
LLM_PROVIDER=none
# Required for openai and google. Optional for anthropic (defaults to claude-haiku-5-5).
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 1 = enable /api/demo/* endpoints the storyboard uses to set each moment's state
DEMO_MODE=1
